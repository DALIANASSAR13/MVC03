@model StudentManagement.Models.Department

@{
    ViewData["Title"] = "Add Department";
}

<h1>Add Department</h1>

<form asp-controller="Department"
      asp-action="Add"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Department Name
        </label>

        <input asp-for="Name" class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MgrName" class="form-label">
            Manager Name
        </label>

        <input asp-for="MgrName" class="form-control" />

        <span asp-validation-for="MgrName"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a href="/Department/ShowAll"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
